{
  "name": "invitations-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:integration": "vitest run --project integration",
    "test:types": "vitest run --project types",
    "db:generate": "DATABASE_MIGRATION_TARGET=development drizzle-kit generate",
    "db:migrate": "node -e \"throw new Error('Choose db:migrate:development or db:migrate:production explicitly.')\"",
    "db:migrate:development": "DATABASE_MIGRATION_TARGET=development node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:production": "DATABASE_MIGRATION_TARGET=production node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.2",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
